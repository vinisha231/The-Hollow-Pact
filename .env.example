# The Hollow Pact — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# AI APIs
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here        # for embeddings (text-embedding-3-small)
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Database
DATABASE_URL=postgresql://hollow_pact:your_password@localhost:5432/hollow_pact

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=generate_a_strong_random_secret_here

# Platform SDKs (leave blank for local dev)
STEAM_WEB_API_KEY=
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=

# Hathora (game server hosting)
HATHORA_APP_ID=
HATHORA_TOKEN=

# AWS (for S3 saves)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=hollow-pact-saves
AWS_REGION=us-east-1

# Environment
ENV=development    # development | staging | production
LOG_LEVEL=INFO
